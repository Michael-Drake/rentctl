{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Michael-Drake/rentctl",
  "description": "Leased dev environments — every server dies when its AI session ends.",
  "repository": {
    "url": "https://github.com/Michael-Drake/rentctl",
    "source": "github"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "rentctl",
      "version": "1.0.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "rentctl"
        },
        {
          "type": "positional",
          "value": "rent-mcp"
        }
      ]
    }
  ]
}
